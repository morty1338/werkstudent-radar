# Copy to .env (git-ignored) and fill in. docker compose reads it.

# The same random string as the GitHub secret WEBHOOK_SECRET (openssl rand -hex 32).
WEBHOOK_SECRET=

# ngrok (free account, no card): dashboard.ngrok.com → "Your Authtoken" and "Domains"
# (the one free dev domain, without https://, e.g. something-random.ngrok-free.app).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
